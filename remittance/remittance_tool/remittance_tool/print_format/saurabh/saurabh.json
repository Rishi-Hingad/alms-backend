{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-04-30 22:15:23.386017",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Remittance Form 15 CB",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "\r\n{% set doc = doc %}\r\n{% set company_name = doc.company or \"\" %}\r\n{% set remitter = \"M/s Meril Life Sciences Pvt. Ltd.\" %}   {# change if stored in a field #}\r\n\r\n<style>\r\n  /* \u2500\u2500 Reset & Base \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  * { box-sizing: border-box; margin: 0; padding: 0; }\r\n\r\n  body, .print-format {\r\n    font-family: Arial, sans-serif;\r\n    font-size: 9pt;\r\n    color: #000;\r\n    background: #fff;\r\n  }\r\n\r\n  /* \u2500\u2500 Page wrapper \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  .cb-wrap {\r\n    width: 100%;\r\n    padding: 10mm 12mm;\r\n  }\r\n\r\n  /* \u2500\u2500 Header \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  .cb-header {\r\n    text-align: center;\r\n    margin-bottom: 6px;\r\n  }\r\n  .cb-header h2 {\r\n    font-size: 13pt;\r\n    font-weight: bold;\r\n    text-decoration: underline;\r\n    letter-spacing: 1px;\r\n  }\r\n  .cb-header h3 {\r\n    font-size: 10pt;\r\n    font-weight: bold;\r\n  }\r\n  .cb-header p {\r\n    font-size: 8.5pt;\r\n    margin-top: 2px;\r\n  }\r\n\r\n  /* \u2500\u2500 Top badge row \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  .badge-row {\r\n    display: flex;\r\n    gap: 6px;\r\n    margin: 8px 0;\r\n  }\r\n  .badge {\r\n    border: 1px solid #333;\r\n    padding: 3px 7px;\r\n    font-size: 8pt;\r\n    border-radius: 2px;\r\n  }\r\n  .badge strong { display: block; font-size: 7pt; color: #555; }\r\n\r\n  /* \u2500\u2500 Main table \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  .cb-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 8px;\r\n  }\r\n  .cb-table td, .cb-table th {\r\n    border: 1px solid #333;\r\n    padding: 4px 6px;\r\n    vertical-align: top;\r\n  }\r\n  .cb-table .label-cell {\r\n    width: 42%;\r\n    font-weight: bold;\r\n    background: #f5f5f5;\r\n  }\r\n  .cb-table .sno {\r\n    width: 28px;\r\n    text-align: center;\r\n    font-weight: bold;\r\n    background: #f5f5f5;\r\n  }\r\n  .cb-table .head-row td {\r\n    background: #dce6f1;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    font-size: 9.5pt;\r\n  }\r\n\r\n  /* sub-table inside cells */\r\n  .inner-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n  }\r\n  .inner-table td {\r\n    border: none;\r\n    border-bottom: 1px dotted #aaa;\r\n    padding: 2px 4px;\r\n  }\r\n  .inner-table tr:last-child td { border-bottom: none; }\r\n\r\n  /* \u2500\u2500 Amount box \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  .amt-box {\r\n    display: flex;\r\n    gap: 12px;\r\n    flex-wrap: wrap;\r\n  }\r\n  .amt-box span { white-space: nowrap; }\r\n\r\n  /* \u2500\u2500 Signature block \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  .sig-block {\r\n    margin-top: 18px;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    font-size: 8.5pt;\r\n  }\r\n  .sig-left, .sig-right { width: 48%; }\r\n  .sig-right { text-align: right; }\r\n  .sig-line { border-top: 1px solid #000; margin-top: 28px; padding-top: 3px; }\r\n\r\n  /* \u2500\u2500 Helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500 */\r\n  .bold   { font-weight: bold; }\r\n  .center { text-align: center; }\r\n  .small  { font-size: 8pt; }\r\n  .indent { padding-left: 12px; }\r\n  .yes-no { font-style: italic; }\r\n</style>\r\n\r\n<div class=\"cb-wrap\">\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       HEADER\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <div class=\"cb-header\">\r\n    <h2>FORM NO. 15CB</h2>\r\n    <h3>(See rule 37BB)</h3>\r\n    <p>Certificate of an accountant*</p>\r\n  </div>\r\n\r\n  <!-- Badge row: TRC / Doc No / PE Purpose / 10F / years -->\r\n  <div class=\"badge-row\">\r\n    <div class=\"badge\"><strong>TRC</strong>{% if doc.trc_obtained %}Yes{% else %}\u2014{% endif %}</div>\r\n    <div class=\"badge\"><strong>Document No.</strong>{{ doc.name }}</div>\r\n    <div class=\"badge\"><strong>PE Purpose Code</strong>&nbsp;</div>\r\n    <div class=\"badge\"><strong>10F</strong>&nbsp;</div>\r\n    <div class=\"badge\"><strong>Year</strong>{{ frappe.utils.nowdate()[:4] }}</div>\r\n  </div>\r\n\r\n  <p style=\"margin-bottom:6px;\">\r\n    We have examined the agreement (wherever applicable) between<br>\r\n    <strong>{{ remitter }} (Remitter)</strong><br>\r\n    and<br>\r\n    <strong>{{ doc.vendor or \"\u2014\" }} (Beneficiary)</strong><br>\r\n    requiring the above remittance as well as the relevant documents and books of account required for\r\n    ascertaining the nature of remittance and for determining the rate of deduction of tax at source as per\r\n    provisions of Chapter-XVII-B. We hereby certify the following:\u2014\r\n  </p>\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       MAIN DETAILS TABLE\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <table class=\"cb-table\">\r\n\r\n    <!-- Row A \u2014 Beneficiary -->\r\n    <tr>\r\n      <td class=\"sno\">A</td>\r\n      <td class=\"label-cell\">Name and address of the beneficiary of the remittance:</td>\r\n      <td>\r\n        <strong>{{ doc.vendor or \"\u2014\" }}</strong><br>\r\n        {{ doc.vendor_address or \"\" }}\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row B1 \u2014 Country / Currency -->\r\n    <tr>\r\n      <td class=\"sno\">B</td>\r\n      <td class=\"label-cell\">1 &nbsp;Country to which remittance is made</td>\r\n      <td>\r\n        <div class=\"inner-table\">\r\n          <table class=\"inner-table\">\r\n            <tr>\r\n              <td><strong>Country:</strong> {{ doc.country_to_remit or \"\u2014\" }}</td>\r\n              <td><strong>Currency:</strong> {{ doc.currency or \"\u2014\" }}</td>\r\n            </tr>\r\n          </table>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row 2 \u2014 Amount payable -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">2 &nbsp;Amount payable</td>\r\n      <td>\r\n        <div class=\"amt-box\">\r\n          <span><strong>In foreign currency:</strong>\r\n            {{ doc.currency }} {{ \"{:,.2f}\".format(doc.amount_payable_foreign or 0) }}\r\n          </span>\r\n          <span><strong>In INR (approx):</strong>\r\n            \u20b9 {{ \"{:,.2f}\".format(doc.amount_payable_inr or 0) }}\r\n            {% if doc.exchange_rate and doc.exchange_rate != 1 %}\r\n              @ {{ doc.exchange_rate }}\r\n            {% endif %}\r\n          </span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row 3 \u2014 Bank name -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">3 &nbsp;Name of the bank and Branch</td>\r\n      <td>{{ doc.get(\"bank_name\") or \"\u2014\" }}</td>\r\n    </tr>\r\n\r\n    <!-- Row 4 \u2014 BSR Code -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">4 &nbsp;BSR Code of the bank branch (7 digit)</td>\r\n      <td>{{ doc.get(\"bsr_code\") or \"\u2014\" }}</td>\r\n    </tr>\r\n\r\n    <!-- Row 5 \u2014 Proposed date -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">5 &nbsp;Proposed date of remittance</td>\r\n      <td>{{ doc.get(\"proposed_date_of_remittance\") or \"\u2014\" }}</td>\r\n    </tr>\r\n\r\n    <!-- Row 6 \u2014 Nature of remittance -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">6 &nbsp;Nature of remittance as per agreement / document</td>\r\n      <td>{{ doc.get(\"nature_of_remittance\") or doc.tax_category or \"\u2014\" }}</td>\r\n    </tr>\r\n\r\n    <!-- Row 7 \u2014 Gross-up -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">7 &nbsp;In case the remittance is net of taxes, whether tax payable has been grossed up?</td>\r\n      <td class=\"yes-no\">{{ \"Yes\" if doc.gross_up else \"No\" }}</td>\r\n    </tr>\r\n\r\n    <!-- Row 8 \u2014 ITA Section -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">8 &nbsp;Taxability under the provisions of Income Tax Act (without considering DTAA)</td>\r\n      <td>\r\n        <table class=\"inner-table\">\r\n          <tr>\r\n            <td><strong>(a) Relevant section of the Act:</strong></td>\r\n            <td>{{ doc.get(\"ita_section\") or \"Section 9(1)(vii) of Income Tax Act, 1961\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(b) TDS Rate as per ITA:</strong></td>\r\n            <td>{{ doc.tds_rate_income_tax_act or 0 }} %</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(c) Gross amount (Foreign):</strong></td>\r\n            <td>{{ doc.currency }} {{ \"{:,.2f}\".format(doc.ita_gross_amount_foreign or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(d) TDS amount (Foreign):</strong></td>\r\n            <td>{{ doc.currency }} {{ \"{:,.2f}\".format(doc.ita_tds_amount_foreign or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(e) Gross amount (INR):</strong></td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.ita_gross_amount_inr or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(f) TDS amount (INR):</strong></td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.ita_tds_amount_inr or 0) }}</td>\r\n          </tr>\r\n        </table>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row 9 \u2014 DTAA -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">9 &nbsp;If any relief is claimed under DTAA</td>\r\n      <td>\r\n        <table class=\"inner-table\">\r\n          <tr>\r\n            <td><strong>(i) TRC obtained?</strong></td>\r\n            <td class=\"yes-no\">{{ \"Yes\" if doc.trc_obtained else \"No\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(ii) Relevant DTAA:</strong></td>\r\n            <td>{{ doc.get(\"applicable_dtaa\") or \"\u2014\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(iii) Relevant article of DTAA:</strong></td>\r\n            <td>{{ doc.get(\"dtaa_article\") or \"\u2014\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(iv) Taxable income as per DTAA (INR):</strong></td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.dtaa_taxable_income or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>(v) Tax liability as per DTAA (INR):</strong></td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.tax_liability or 0) }}</td>\r\n          </tr>\r\n        </table>\r\n\r\n        <hr style=\"margin:6px 0; border-color:#ccc;\">\r\n\r\n        <!-- Sub-section A: Royalties / FTS / Interest / Dividend -->\r\n        <p class=\"bold\">A. Royalties / FTS / Interest / Dividend (not connected with PE):</p>\r\n        <table class=\"inner-table\">\r\n          <tr>\r\n            <td class=\"indent\">(a) Article of DTAA:</td>\r\n            <td>{{ doc.get(\"dtaa_article\") or \"\u2014\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">(b) Rate of TDS as per DTAA (%):</td>\r\n            <td>{{ doc.tds_rate_as_per_dtaa or 0 }} %</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">&nbsp;&nbsp;Gross amount (Foreign):</td>\r\n            <td>{{ doc.currency }} {{ \"{:,.2f}\".format(doc.gross_amount_foreign or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">&nbsp;&nbsp;TDS amount (Foreign):</td>\r\n            <td>{{ doc.currency }} {{ \"{:,.2f}\".format(doc.tds_amount_foreign or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">&nbsp;&nbsp;Gross amount (INR):</td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.gross_amount_inr or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">&nbsp;&nbsp;TDS amount (INR):</td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.tds_amount_inr or 0) }}</td>\r\n          </tr>\r\n        </table>\r\n\r\n        <!-- Sub-section B: Business income -->\r\n        <p class=\"bold\" style=\"margin-top:5px;\">B. Business income:</p>\r\n        <table class=\"inner-table\">\r\n          <tr>\r\n            <td class=\"indent\">(a) Amount liable to tax in India:</td>\r\n            <td class=\"yes-no\">{{ \"Yes\" if doc.income_taxable_in_india else \"No\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">(b) Basis of arriving at rate of deduction:</td>\r\n            <td>{{ doc.get(\"basis_of_rate\") or \"\u2014\" }}</td>\r\n          </tr>\r\n        </table>\r\n\r\n        <!-- Sub-section C: Capital gains -->\r\n        <p class=\"bold\" style=\"margin-top:5px;\">C. Capital gains:</p>\r\n        <table class=\"inner-table\">\r\n          <tr>\r\n            <td class=\"indent\">(a) Long term capital gains:</td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.long_term_capital_gains_amount or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">(b) Short term capital gains:</td>\r\n            <td>\u20b9 {{ \"{:,.2f}\".format(doc.short_term_capital_gains_amount or 0) }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">(c) Basis of arriving at taxable income:</td>\r\n            <td>{{ doc.get(\"capital_gains_basis\") or \"\u2014\" }}</td>\r\n          </tr>\r\n        </table>\r\n\r\n        <!-- Sub-section D: Other remittance -->\r\n        <p class=\"bold\" style=\"margin-top:5px;\">D. Other remittance:</p>\r\n        <table class=\"inner-table\">\r\n          <tr>\r\n            <td class=\"indent\">(a) Nature:</td>\r\n            <td>{{ doc.get(\"other_nature\") or \"\u2014\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">(b) Taxable in India as per DTAA?</td>\r\n            <td class=\"yes-no\">{{ \"Yes\" if doc.taxable_in_india_as_per_dtaa else \"No\" }}</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">(c) Rate of TDS (if yes):</td>\r\n            <td>{{ doc.applicable_tds_rate or 0 }} %</td>\r\n          </tr>\r\n          <tr>\r\n            <td class=\"indent\">(d) Reasons (if not):</td>\r\n            <td>{{ doc.get(\"dtaa_not_taxable_reason\") or \"\u2014\" }}</td>\r\n          </tr>\r\n        </table>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row 10 \u2014 Amount of TDS -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">10 &nbsp;Amount of TDS</td>\r\n      <td>\r\n        <div class=\"amt-box\">\r\n          <span><strong>In foreign currency:</strong>\r\n            {{ doc.currency }} {{ \"{:,.2f}\".format(doc.tds_amount_foreign or 0) }}\r\n          </span>\r\n          <span><strong>In INR:</strong>\r\n            \u20b9 {{ \"{:,.2f}\".format(doc.total_tax_amount or 0) }}\r\n          </span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row 11 \u2014 Rate of TDS -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">11 &nbsp;Rate of TDS</td>\r\n      <td>\r\n        <table class=\"inner-table\">\r\n          <tr>\r\n            <td><strong>As per Income Tax Act:</strong></td>\r\n            <td>{{ doc.tds_rate_income_tax_act or 0 }} %</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>As per DTAA:</strong></td>\r\n            <td>{{ doc.tds_rate_as_per_dtaa or 0 }} %</td>\r\n          </tr>\r\n          <tr>\r\n            <td><strong>Applied rate:</strong></td>\r\n            <td>{{ doc.applied_rate or 0 }} %</td>\r\n          </tr>\r\n        </table>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row 12 \u2014 Net amount after TDS -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">12 &nbsp;Actual amount of remittance after TDS</td>\r\n      <td>\r\n        <div class=\"amt-box\">\r\n          <span><strong>In foreign currency:</strong>\r\n            {{ doc.currency }} {{ \"{:,.2f}\".format(doc.actual_amt_after_tds_foreign or 0) }}\r\n          </span>\r\n          <span><strong>In INR:</strong>\r\n            \u20b9 {{ \"{:,.2f}\".format(doc.actual_amt_after_tds_inr or 0) }}\r\n          </span>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- Row 13 \u2014 Date of deduction -->\r\n    <tr>\r\n      <td class=\"sno\"></td>\r\n      <td class=\"label-cell\">13 &nbsp;Date of deduction of tax at source, if any</td>\r\n      <td>{{ doc.get(\"date_of_tds_deduction\") or \"\u2014\" }}</td>\r\n    </tr>\r\n\r\n  </table><!-- end cb-table -->\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       INVOICE LIST (child table)\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  {% if doc.invoices %}\r\n  <p class=\"bold\" style=\"margin-top:10px;\">Invoice Details:</p>\r\n  <table class=\"cb-table\" style=\"margin-top:4px;\">\r\n    <tr style=\"background:#dce6f1; font-weight:bold; text-align:center;\">\r\n      <td>#</td>\r\n      <td>SAP Doc No.</td>\r\n      <td>Invoice No.</td>\r\n      <td>Doc Type</td>\r\n      <td>Doc Date</td>\r\n      <td>Amount ({{ doc.currency }})</td>\r\n      <td>Amount (INR)</td>\r\n    </tr>\r\n    {% for inv in doc.invoices %}\r\n    <tr>\r\n      <td class=\"center\">{{ loop.index }}</td>\r\n      <td>{{ inv.sap_document_no or \"\u2014\" }}</td>\r\n      <td>{{ inv.invoice_no or \"\u2014\" }}</td>\r\n      <td>{{ inv.document_type or \"\u2014\" }}</td>\r\n      <td>{{ inv.document_date or \"\u2014\" }}</td>\r\n      <td class=\"center\">{{ \"{:,.2f}\".format(inv.wrshb or 0) }}</td>\r\n      <td class=\"center\">{{ \"{:,.2f}\".format(inv.dmshb or 0) }}</td>\r\n    </tr>\r\n    {% endfor %}\r\n    <tr style=\"font-weight:bold; background:#f5f5f5;\">\r\n      <td colspan=\"5\" style=\"text-align:right;\">Total</td>\r\n      <td class=\"center\">{{ \"{:,.2f}\".format(doc.invoices | sum(attribute='wrshb') or 0) }}</td>\r\n      <td class=\"center\">{{ \"{:,.2f}\".format(doc.invoices | sum(attribute='dmshb') or 0) }}</td>\r\n    </tr>\r\n  </table>\r\n  {% endif %}\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       DECLARATION\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <p style=\"margin-top:10px; font-size:8.5pt;\">\r\n    The information given above is true and correct to the best of my knowledge and belief and is in\r\n    accordance with the books of account, documents and other records maintained by the assessee in\r\n    the ordinary course of business.\r\n  </p>\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       SIGNATURE BLOCK\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <div class=\"sig-block\">\r\n    <div class=\"sig-left\">\r\n      <p><strong>Place:</strong> ___________________________</p>\r\n      <br>\r\n      <p><strong>Date:</strong> ____________________________</p>\r\n    </div>\r\n    <div class=\"sig-right\">\r\n      <div class=\"sig-line\">\r\n        Signature of the accountant<br>\r\n        <strong>Name &amp; Address:</strong><br>\r\n        _______________________________<br>\r\n        _______________________________<br>\r\n        <strong>Membership No.:</strong> ________________\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <p class=\"small\" style=\"margin-top:10px; color:#555;\">\r\n    * Accountant means a person referred to in the Explanation below sub-section (2) of section 288 of the Income Tax Act, 1961.\r\n  </p>\r\n\r\n</div><!-- end cb-wrap -->",
