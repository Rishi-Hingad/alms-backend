{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-05-07 15:42:20.132630",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Remittance Form 15 CB",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\r\n/* \u2500\u2500\u2500 Frappe Print Format: Form 15CB \u2500\u2500\u2500 */\r\n\r\n.f15cb * { box-sizing: border-box; }\r\n\r\n.f15cb {\r\n  font-family: \"Times New Roman\", Times, serif;\r\n  font-size: 10pt;\r\n  color: #000;\r\n  width: 100%;\r\n}\r\n\r\n/* \u2500\u2500 TOP META BAR \u2500\u2500 */\r\n.f15cb .top-meta {\r\n  display: table;\r\n  width: 100%;\r\n  border-bottom: 2px solid #000;\r\n  padding-bottom: 6px;\r\n  margin-bottom: 6px;\r\n}\r\n.f15cb .top-meta-left {\r\n  display: table-cell;\r\n  width: 25%;\r\n  vertical-align: top;\r\n}\r\n.f15cb .top-meta-right {\r\n  display: table-cell;\r\n  width: 25%;\r\n  vertical-align: bottom;\r\n  text-align: right;\r\n}\r\n.f15cb .td-heading {\r\n  font-weight: bold;\r\n  font-size: 10pt;\r\n  margin-bottom: 4px;\r\n}\r\n\r\n/* \u2500\u2500 TAX DOCS TABLE \u2014 reduced padding \u2500\u2500 */\r\n.f15cb .tax-docs-tbl {\r\n  border-collapse: collapse;\r\n  font-size: 7pt;\r\n}\r\n.f15cb .tax-docs-tbl td {\r\n  border: 1px solid #555;\r\n  padding: 2px 5px;        /* \u2190 reduced from 3px 8px */\r\n}\r\n\r\n/* \u2500\u2500 META TABLE (Sr.No / Document No / Purpose Code) \u2014 reduced padding \u2500\u2500 */\r\n.f15cb .meta-tbl {\r\n  border-collapse: collapse;\r\n  font-size: 7pt;\r\n  display: inline-table;\r\n}\r\n.f15cb .meta-tbl td {\r\n  border: 1px solid #666;\r\n  padding: 8px !important;        /* \u2190 reduced from 3px 10px */\r\n}\r\n.f15cb .meta-tbl td:first-child {\r\n  font-weight: bold;\r\n  background: #f2f2f2;\r\n  white-space: nowrap;\r\n}\r\n.f15cb .meta-tbl td:last-child {\r\n  font-weight: bold;\r\n  min-width: 90px;\r\n}\r\n\r\n/* \u2500\u2500 FORM HEADER \u2500\u2500 */\r\n.f15cb .form-header {\r\n  text-align: center;\r\n  margin: 50px 0 6px;\r\n  line-height: 1.6;\r\n}\r\n.f15cb .form-header .f-title { font-size: 14pt; font-weight: bold; letter-spacing: 0.5px; }\r\n.f15cb .form-header .f-rule  { font-size: 10pt; }\r\n.f15cb .form-header .f-cert  { font-size: 10.5pt; font-weight: bold; }\r\n\r\n/* \u2500\u2500 PREAMBLE \u2500\u2500 */\r\n.f15cb .preamble {\r\n  border: 1px solid #777;\r\n  padding: 8px 14px;\r\n  margin: 5px 0 0px;\r\n  font-size: 10pt;\r\n  text-align: center;\r\n  line-height: 1.7;\r\n}\r\n\r\n/* \u2500\u2500 MAIN TABLE \u2500\u2500 */\r\n.f15cb .f15 {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  font-size: 9.5pt;\r\n  table-layout: fixed;\r\n}\r\n.f15cb .f15 td {\r\n  border: 1px solid #555;\r\n  padding: 4px 6px;\r\n  vertical-align: top;\r\n  word-wrap: break-word;\r\n  overflow-wrap: break-word;\r\n}\r\n\r\n/* Fixed column widths */\r\n.f15cb .f15 .c-idx   { width: 4%;  text-align: center; vertical-align: middle; font-weight: bold; }\r\n.f15cb .f15 .c-label { width: 50%; }\r\n.f15cb .f15 .c-fc    { width: 23%; text-align: center; vertical-align: middle; }\r\n.f15cb .f15 .c-inr   { width: 23%; text-align: center; vertical-align: middle; }\r\n\r\n/* Indentation */\r\n.f15cb .ind1 { padding-left: 16px !important; }\r\n.f15cb .ind2 { padding-left: 28px !important; }\r\n\r\n/* Utility */\r\n.f15cb .center { text-align: center; }\r\n.f15cb .bold   { font-weight: bold; }\r\n.f15cb .red    { color: #c00000; font-weight: bold; }\r\n.f15cb .vmid   { vertical-align: middle !important; }\r\n\r\n/* Row highlights */\r\n.f15cb .bg-yellow    { background-color: #ffff99 !important; }\r\n.f15cb .bg-amber     { background-color: #ffc000 !important; }\r\n.f15cb .bg-blue      { background-color: #9dc3e6 !important; }\r\n.f15cb .bg-lightblue { background-color: #bdd7ee !important; }\r\n.f15cb .bg-pale      { background-color: #f5f5f5 !important; }\r\n\r\n/* Split header/value inside cells */\r\n.f15cb .s-head {\r\n  font-size: 8pt;\r\n  color: #444;\r\n  border-bottom: 1px solid #bbb;\r\n  padding-bottom: 2px;\r\n  margin-bottom: 2px;\r\n  text-align: center;\r\n}\r\n.f15cb .s-val  { font-weight: bold; text-align: center; }\r\n.f15cb .s-note { font-size: 7.5pt; color: #555; text-align: center; }\r\n\r\n/* Dual columns (country/currency) */\r\n.f15cb .dual-cell { display: table; width: 100%; }\r\n.f15cb .dual-cell .dc-left,\r\n.f15cb .dual-cell .dc-right {\r\n  display: table-cell;\r\n  width: 50%;\r\n  padding: 2px 4px;\r\n  vertical-align: top;\r\n}\r\n.f15cb .dual-cell .dc-right { border-left: 1px solid #ddd; }\r\n.f15cb .d-lbl { font-size: 8pt; color: #555; display: block; }\r\n.f15cb .d-val { font-weight: bold; }\r\n\r\n/* \u2500\u2500 FOOTER \u2500\u2500 */\r\n.f15cb .f-footer {\r\n  margin-top: 8px;\r\n  font-size: 8pt;\r\n  font-style: italic;\r\n  color: #444;\r\n  text-align: center;\r\n}\r\n\r\n/* \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n   PAGINATION\r\n   - .page-break   \u2192 force a new page BEFORE this element\r\n   - .no-break     \u2192 keep this row/element together, never split mid-element\r\n   - @page rules   \u2192 tell the PDF renderer about page size & margins\r\n   All three work together: @page sets the canvas,\r\n   page-break-before inserts hard breaks where you place them,\r\n   page-break-inside:avoid stops rows from splitting across pages.\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 */\r\n@page {\r\n  size: A4 portrait;\r\n  margin: 12mm 10mm 15mm 10mm;  /* top right bottom left */\r\n}\r\n\r\n/* Hard page break \u2014 place a <div class=\"page-break\"></div>\r\n   anywhere in the HTML to start a new page there */\r\n.f15cb .page-break {\r\n  page-break-before: always;\r\n  break-before: page;\r\n  display: block;\r\n  height: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\n\r\n/* Prevent individual table rows from splitting across pages */\r\n.f15cb .f15 tr {\r\n  page-break-inside: avoid;\r\n  break-inside: avoid;\r\n}\r\n\r\n/* Prevent the preamble box from splitting */\r\n.f15cb .preamble {\r\n  page-break-inside: avoid;\r\n  break-inside: avoid;\r\n}\r\n\r\n/* Prevent the top meta bar from splitting */\r\n.f15cb .top-meta {\r\n  page-break-inside: avoid;\r\n  break-inside: avoid;\r\n}\r\n\r\n/* Page number footer \u2014 shown only in print/PDF */\r\n@media print {\r\n  .f15cb { font-size: 9pt; }\r\n  .f15cb .f15 { font-size: 9pt; }\r\n\r\n  /* Running page number at bottom of every page */\r\n  .f15cb .f-footer {\r\n    position: running(footer);\r\n  }\r\n  @page {\r\n    @bottom-center {\r\n      content: \"Page \" counter(page) \" of \" counter(pages);\r\n      font-family: \"Times New Roman\", Times, serif;\r\n      font-size: 8pt;\r\n      color: #555;\r\n    }\r\n  }\r\n}\r\n\r\n/* In your <style> block, add: */\r\n\r\n/* Remove inner borders between B column cells so they appear merged */\r\n.f15cb .f15 .b-col {\r\n  border-top: none !important;\r\n  border-bottom: none !important;\r\n  border-right: 1px solid #555 !important;\r\n  border-left: 1px solid #555 !important;\r\n}\r\n\r\n/* Keep top border on first B row and bottom border on last B row */\r\n.f15cb .f15 .b-col-first {\r\n  border-top: 1px solid #555 !important;\r\n  border-bottom: none !important;\r\n}\r\n.f15cb .f15 .b-col-last {\r\n  border-bottom: 1px solid #555 !important;\r\n  border-top: none !important;\r\n}\r\n</style>\r\n\r\n<div class=\"f15cb\">\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       TOP META BAR\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <div class=\"top-meta\">\r\n    <div class=\"top-meta-left\">\r\n      <div class=\"td-heading\">Tax Documents</div>\r\n\r\n      {% set dtaa_doc = frappe.db.get_value(\"Remittance DTAA Tax Documents\", {\"vendor\": doc.vendor}, \"name\") %}\r\n\r\n        {% if dtaa_doc %}\r\n            {% set dtaa = frappe.get_doc(\"Remittance DTAA Tax Documents\", dtaa_doc) %}\r\n        \r\n            {# get only enabled rows #}\r\n            {% set enabled_docs = dtaa.tax_documents | selectattr(\"enabled\", \"equalto\", 1) | list %}\r\n        \r\n            {% if enabled_docs %}\r\n        \r\n            <table style=\"border-collapse: collapse; font-size: 7pt;\">\r\n              <tr>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\"></td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\">From Date</td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\">To Date</td>\r\n              </tr>\r\n        \r\n              {% for row in enabled_docs %}\r\n              <tr>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\r\n                  <strong>{{ row.tax_document_type or \"\" }}</strong>\r\n                </td>\r\n        \r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\r\n                  {{ frappe.utils.formatdate(row.effective_from, \"dd-MM-yyyy\") if row.effective_from else \"\u2014\" }}\r\n                </td>\r\n        \r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\r\n                  {{ frappe.utils.formatdate(row.effective_to, \"dd-MM-yyyy\") if row.effective_to else \"\u2014\" }}\r\n                </td>\r\n              </tr>\r\n              {% endfor %}\r\n            </table>\r\n        \r\n            {% else %}\r\n        \r\n            {# same blank table when no enabled rows #}\r\n            <table style=\"border-collapse: collapse; font-size: 7pt;\">\r\n              <tr>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\"></td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\">From Date</td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\">To Date</td>\r\n              </tr>\r\n              <tr>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\"><strong>TRC</strong></td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n              </tr>\r\n              <tr>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\"><strong>PE</strong></td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n              </tr>\r\n              <tr>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\"><strong>10F</strong></td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n                <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n              </tr>\r\n            </table>\r\n        \r\n            {% endif %}\r\n        \r\n        {% else %}\r\n        \r\n        <table style=\"border-collapse: collapse; font-size: 7pt;\">\r\n          <tr>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\"></td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\">From Date</td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important; background: #f2f2f2; font-size:7pt; color:#555;\">To Date</td>\r\n          </tr>\r\n          <tr>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\"><strong>TRC</strong></td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n          </tr>\r\n          <tr>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\"><strong>PE</strong></td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n          </tr>\r\n          <tr>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\"><strong>10F</strong></td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n            <td style=\"border: 1px solid #555; padding: 4px !important;\">\u2014</td>\r\n          </tr>\r\n        </table>\r\n        \r\n        {% endif %}\r\n    </div>\r\n\r\n    <div class=\"top-meta-right\">\r\n      <table class=\"meta-tbl\">\r\n        <tr>\r\n          <td>Sr. No.</td>\r\n          <td>{{ doc.name or \"\" }}</td>\r\n        </tr>\r\n        <tr>\r\n          <td>Document No.</td>\r\n          <!--<td>-->\r\n          <!--  {% set ns = namespace(docs=[]) %}-->\r\n          <!--  {% for inv in doc.invoices %}{% set ns.docs = ns.docs + [(inv.sap_document_no or inv.name or \"\")]%}{% endfor %}-->\r\n          <!--  {{ ns.docs | join(\"/\") }}-->\r\n          <!--</td>-->\r\n          <!--<td style=\"border: 1px solid #666 !important; padding: 0 !important; font-weight: bold; background: #f2f2f2; white-space: nowrap;\">Document No.</td>-->\r\n          <td style=\"border: 1px solid #666 !important; font-weight: bold; min-width: 90px; max-width: 150px; word-break: break-all; white-space: normal;\">\r\n            {% set ns = namespace(docs=[]) %}\r\n            {% for inv in doc.invoices %}{% set ns.docs = ns.docs + [(inv.sap_document_no or inv.name or \"\")]%}{% endfor %}\r\n            {{ ns.docs | join(\"/\") }}\r\n          </td>\r\n        </tr>\r\n        <tr>\r\n          <td>Purpose Code</td>\r\n          <td>{{ doc.purpose_code or \"\" }}</td>\r\n        </tr>\r\n      </table>\r\n    </div>\r\n  </div>\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       FORM HEADER\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <div class=\"form-header\">\r\n    <div class=\"f-title\">FORM NO. 146</div>\r\n    <div class=\"f-rule\">[ See rule 220(1)(C) ]</div>\r\n    <div class=\"f-cert\">Certificate of an accountant*</div>\r\n  </div>\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       PREAMBLE\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <div class=\"preamble\">\r\n    We have examined the agreement (wherever applicable) between<br>\r\n    {% set company_name = frappe.db.get_value(\"Remittance Company\", doc.company, \"company_name\") %}\r\n    <strong>M/s {{ company_name or doc.company or \"____________________\" }} (Remitter)</strong><br>\r\n    and<br>\r\n    {% set vendor_name = frappe.db.get_value(\"Remittance Vendor\", doc.vendor, \"vendor_name\") %}\r\n    <strong>{{ vendor_name or doc.vendor or \"____________________\" }} (Beneficiary)</strong><br>\r\n    requiring the above remittance as well as the relevant documents and books of account required for ascertaining the nature of\r\n    remittance and for determining the rate of deduction of tax at source as per provisions of Charter- XVII-B.\r\n    We hereby certify the following:-\r\n  </div>\r\n\r\n  <!-- \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n       MAIN TABLE\r\n  \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550 -->\r\n  <table class=\"f15\">\r\n    <colgroup>\r\n      <col style=\"width:4%\">\r\n      <col style=\"width:6%\">\r\n      <col style=\"width:46%\">\r\n      <col style=\"width:22%\">\r\n      <col style=\"width:22%\">\r\n    </colgroup>\r\n\r\n    <!-- A: Beneficiary -->\r\n    <tr>\r\n      <td class=\"c-idx vmid\">A</td>\r\n      <td colspan=\"2\">\r\n        Name and address of the beneficiary of the remittance:<br>\r\n        <strong>{{ vendor_name or doc.vendor or \"\" }}<br>\r\n        {{ doc.vendor_address or \"\" }}</strong>\r\n      </td>\r\n      <td colspan=\"2\">\r\n        TIN No.:<br>\r\n        {% set tax_id = frappe.db.get_value(\"Remittance Vendor\", doc.vendor, \"tax_id_no\") %}\r\n        <strong>{{tax_id or doc.v_tax_id_no or \"\"}}</strong>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 1: Country / Currency -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col-first\">B</td>\r\n      <td class=\"c-idx vmid\">1</td>\r\n      <td class=\"c-label vmid\">Country to which remittance is made</td>\r\n      <td colspan=\"2\">\r\n        <div class=\"dual-cell\">\r\n          <div class=\"dc-left\">\r\n            <span class=\"d-lbl\">Country:</span>\r\n            <span class=\"d-val\">{{ doc.country_to_remit or \"\" }}</span>\r\n          </div>\r\n          <div class=\"dc-right\">\r\n            <span class=\"d-lbl\">Currency:</span>\r\n            <span class=\"d-val\">{{ doc.currency or \"\" }}</span>\r\n          </div>\r\n        </div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 2: Amount payable -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">2</td>\r\n      <td class=\"c-label vmid\">Amount payable</td>\r\n      <td class=\"c-fc\">\r\n        <div class=\"s-head\">In {{ doc.currency or \"\" }}</div>\r\n        <div class=\"s-val\">\r\n            {% if doc.gross_up==1 %}\r\n            {{ \"{:,.2f}\".format(doc.amount_payable_foreign or 0) }}\r\n            {% else %}\r\n            {{ \"{:,.2f}\".format(doc.net_amount_foreign or 0) }}\r\n            {% endif %}\r\n        </div>\r\n        <div class=\"s-note\"></div>\r\n      </td>\r\n      <td class=\"c-inr\">\r\n        <div class=\"s-head\">In INR</div>\r\n        <div class=\"s-val\">\r\n            {% if doc.gross_up==1 %}\r\n            {{ \"{:,.0f}\".format(doc.amount_payable_inr or 0) }}\r\n            {% else %}\r\n            {{ \"{:,.2f}\".format(doc.net_amount_inr or 0) }}\r\n            {% endif %}\r\n        </div>\r\n        <div class=\"s-note\">(approx) @ {{ doc.exchange_rate or 0 }}</div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 3: Bank -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">3</td>\r\n      <td class=\"c-label vmid\">Name of the bank and Branch</td>\r\n      <td colspan=\"2\" class=\"center vmid\">\r\n        {% set branch_name = frappe.db.get_value(\"Remittance Bank Branch\", doc.bank_branch, \"branch_name\") %}\r\n        {{ doc.bank_name or \"\" }}{% if doc.bank_name and doc.bank_branch %}, {% endif %}{{ branch_name or doc.bank_branch or \"\" }}\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 4: BSR Code -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">4</td>\r\n      <td class=\"c-label vmid\">BSR Code of the bank branch (7 digit)</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">{{ doc.bsr_code or \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 5: IFSC Code -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">5</td>\r\n      <td class=\"c-label vmid\">IFSC Code of the bank branch</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">{{ doc.ifsc_code or \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 6: Proposed date -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">6</td>\r\n      <td class=\"c-label vmid\">Proposed date of remittance</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">\r\n        {% if doc.proposed_date_of_remittance %}{{ frappe.utils.formatdate(doc.proposed_date_of_remittance, \"dd-MM-yyyy\") }}{% endif %}\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 7: Nature of Remittance -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">7</td>\r\n      <td class=\"c-label vmid\">Nature of remittance as per agreement/ document</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">{{ doc.nature_of_remittance or \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 8: Gross Up -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">8</td>\r\n      <td class=\"c-label vmid\">In case the remittance is net of taxes, whether tax payable has been grossed up?</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">{{ \"Yes\" if doc.gross_up else \"No\" }}</td>\r\n    </tr>\r\n    \r\n    <!-- 9: IT Act heading -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\" style=\"vertical-align:top;padding-top:5px;\"></td>\r\n      <td class=\"c-idx\" style=\"vertical-align:top;padding-top:5px;\">9</td>\r\n      <td colspan=\"3\">Taxability under the provision of Income Tax Act (without considering DTAA)</td>\r\n    </tr>\r\n\r\n    <!-- 9(a) -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(a) the relevant section of the act under which the remittance is covered</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ doc.section_of_act or \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 9(b) Taxable Income -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(b) the amount of income chargeable to tax</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">INR {{ \"{:,.0f}\".format(doc.taxable_income or 0) }}</td>\r\n    </tr>\r\n\r\n    <!-- 9(c) Tax Liability -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(c) the tax liability</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">INR {{ \"{:,.0f}\".format(doc.tax_liability or 0) }}</td>\r\n    </tr>\r\n\r\n    <!-- 9(d) Basis -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(d) basis of determining taxable income and tax liability</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ doc.basis_for_taxable_income_and_tax_liability_calculation or \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 10: DTAA heading -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\" style=\"vertical-align:top;padding-top:5px;\"></td>\r\n      <td class=\"c-idx\" style=\"vertical-align:top;padding-top:5px;\">10</td>\r\n      <td colspan=\"3\">If any relief is claimed under DTAA-</td>\r\n    </tr>\r\n\r\n    <!-- 10(i) TRC -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(i) whether tax residency certificate is obtained from the recipient of remittance</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">{{ \"Yes\" if doc.trc_obtained else \"No\" }}</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(ii) TRC No.:</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\"> {{ doc.tax_residency_number if doc.trc_obtained else \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 10(ii) DTAA Name -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(iii) please specify relevant DTAA</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">{{ doc.dtaa_name if doc.trc_obtained else \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 10(iii) DTAA Article -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(iv) please specify relevant article of DTAA</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ doc.dtaa_article or doc.applicable_dtaa_article if doc.trc_obtained else \"\" }}</td>\r\n    </tr>\r\n    \r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(v) Nature of Payment</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ doc.nature_of_remittance if doc.trc_obtained else \"\" }}</td>\r\n    </tr>\r\n\r\n    <!-- 10(iv) DTAA Taxable Income -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(vi) taxable income as per DTAA</td>\r\n      <td class=\"center vmid\" style=\"font-size:8.5pt;\">In INR</td>\r\n      <td class=\"center vmid bold\">\r\n          {% if doc.trc_obtained %}\r\n          {{ \"{:,.0f}\".format(doc.dtaa_taxable_income or 0) }}\r\n          {% endif %}\r\n        </td>\r\n    </tr>\r\n\r\n    <!-- 10(v) DTAA Tax Liability -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind1\">(vii) tax liability as per DTAA</td>\r\n      <td class=\"center vmid\" style=\"font-size:8.5pt;\">In INR</td>\r\n      <td class=\"center vmid bold\">\r\n          \r\n          {% if doc.trc_obtained %}\r\n          {{ \"{:,.0f}\".format(doc.dtaa_tax_liability or 0) }}\r\n          {% endif %}\r\n          </td>\r\n    </tr>\r\n\r\n    <!-- A. Royalty / FTS -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"ind1\" colspan=\"1\">\r\n        A. If the remittance is for royalties, fee for technical services, interest, dividend etc.\r\n        (not connected with permanent establishment) please indicate :-\r\n      </td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ \"Yes\" if doc.tax_category == \"Royalty / FTS / Interest / Dividend\" else \"No\" }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(a) Article of DTAA</td>\r\n      <td colspan=\"2\" class=\"center vmid\">\r\n        {% if doc.tax_category == \"Royalty / FTS / Interest / Dividend\" %}{{ doc.applicable_dtaa_article or doc.dtaa_article or \"\" }}{% endif %}\r\n      </td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(b) Rate of TDS required to be deducted in terms of such article of the applicable DTAA</td>\r\n      <td class=\"center vmid\" style=\"font-size:8.5pt;\">As per DTAA (%)</td>\r\n      <td class=\"center vmid bold\">{% if doc.tax_category == \"Royalty / FTS / Interest / Dividend\"%}{{ doc.tds_rate_as_per_dtaa if doc.tds_rate_as_per_dtaa else \"0\" }}%{% endif %}</td>\r\n    </tr>\r\n\r\n    <!-- B. Business Income -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"ind1\" colspan=\"1\">B. In case the remittance is on account of business income, please indicate:-</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ \"Yes\" if doc.tax_category == \"Business Income\" else \"No\" }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(a) The amount of income is liable to tax in India</td>\r\n      <td colspan=\"2\" class=\"center vmid\"></td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(b) The basis of arriving at the rate of deduction of tax</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Business Income\" %}{{ doc.basis_for_tax_deduction_rate or \"\" }}{% endif %}</td>\r\n    </tr>\r\n\r\n    <!-- C. Capital Gains -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"ind1\" colspan=\"1\">C. In case the remittance is on account of capital gains, please indicate:-</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ \"Yes\" if doc.tax_category == \"Capital Gains\" else \"No\" }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(a) amount of long term capital gains</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Capital Gains\" %}{{ \"{:,.0f}\".format(doc.long_term_capital_gains_amount or 0) }}{% endif %}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(b) amount of short-term capital gains</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Capital Gains\" %}{{ \"{:,.0f}\".format(doc.short_term_capital_gains_amount or 0) }}{% endif %}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(c) basis of arriving at taxable income</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Capital Gains\" %}{{ doc.basis_for_taxable_income_calculation or \"\" }}{% endif %}</td>\r\n    </tr>\r\n\r\n    <!-- D. Other -->\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"ind1\" colspan=\"1\">D. In case of other remittance not covered by sub-items A, B &amp; C</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{{ \"Yes\" if doc.tax_category == \"Other\" else \"No\" }}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(a) Please specify nature of remittance</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Other\" %}{{ doc.specify_nature_of_remittance or \"\" }}{% endif %}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(b) Whether taxable in India as per DTAA</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Other\" %}{{ \"Yes\" if doc.taxable_in_india_as_per_dtaa else \"No\" }}{% endif %}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(c) If yes, rate of TDS required to be deducted in terms of such article of applicable DTAA</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Other\" and doc.taxable_in_india_as_per_dtaa %}{{ doc.applicable_tds_rate or \"\" }}%{% endif %}</td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx b-col\"></td>\r\n      <td class=\"c-idx\"></td>\r\n      <td class=\"c-label ind2\">(d) if not, please furnish brief reasons thereof, specifying article of DTAA</td>\r\n      <td colspan=\"2\" class=\"center vmid\">{% if doc.tax_category == \"Other\" and not doc.taxable_in_india_as_per_dtaa %}{{ doc.reason_for_non_taxability or \"\" }}{% endif %}</td>\r\n    </tr>\r\n\r\n    <!-- 11: Amount of TDS -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">11</td>\r\n      <td class=\"c-label vmid\">Amount of TDS</td>\r\n      <td class=\"c-fc\">\r\n        <div class=\"s-head\">In {{ doc.currency or \"\" }}</div>\r\n        <div class=\"s-val\">\r\n          {% if doc.applied_rate == doc.tds_rate_income_tax_act %}\r\n            {{ \"{:,.2f}\".format(doc.ita_tds_amount_foreign or 0) }}\r\n          {% else %}\r\n            {{ \"{:,.2f}\".format(doc.tds_amount_foreign or 0) }}\r\n          {% endif %}\r\n        </div>\r\n      </td>\r\n      <td class=\"c-inr\">\r\n        <div class=\"s-head\">In INR</div>\r\n        <div class=\"s-val\">\r\n          {% if doc.applied_rate == doc.tds_rate_income_tax_act %}\r\n            {{ \"{:,.0f}\".format(doc.ita_tds_amount_inr or 0) }}\r\n          {% else %}\r\n            {{ \"{:,.0f}\".format(doc.tds_amount_inr or 0) }}\r\n          {% endif %}\r\n        </div>\r\n        <div class=\"s-note\">(approx) @ {{ doc.exchange_rate or 0 }}</div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 12: Rate of TDS -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">12</td>\r\n      <td class=\"c-label vmid\">Rate of TDS</td>\r\n      <td class=\"c-fc\">\r\n        <div class=\"s-head\">As per Income Tax Act</div>\r\n        <div class=\"s-val\">{{ doc.tds_rate_income_tax_act or \"\" }}%</div>\r\n      </td>\r\n      <td class=\"c-inr\">\r\n        <div class=\"s-head\">As per DTAA</div>\r\n        <div class=\"s-val\">\r\n          {% if doc.trc_obtained and doc.tds_rate_dtaa %}\r\n            {{ doc.tds_rate_dtaa }}%\r\n            {% if doc.tds_rate_dtaa == doc.applied_rate %}(Since TRC provided tax @{{ doc.tds_rate_dtaa }}%){% endif %}\r\n          {% endif %}\r\n          {% if doc.trc_obtained and doc.tds_rate_dtaa==0 and doc.applied_rate==0 %}\r\n          0%\r\n          (Since TRC provided tax @NIL)\r\n          {% endif %}\r\n          {% if doc.trc_obtained==0%}\r\n          (Since TRC not provided tax @{{ doc.tds_rate_income_tax_act}}%)\r\n          {% endif %}\r\n        </div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 13: Actual amount after TDS -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">13</td>\r\n      <td class=\"c-label vmid\">Actual amount of remittance after TDS.</td>\r\n      <td class=\"c-fc\">\r\n        <div class=\"s-head\">In {{ doc.currency or \"\" }}</div>\r\n        <div class=\"s-val\">{{ \"{:,.2f}\".format(doc.actual_amt_after_tds_foreign or 0) }}</div>\r\n      </td>\r\n      <td class=\"c-inr\">\r\n        <div class=\"s-head\">In INR</div>\r\n        <div class=\"s-val\">{{ \"{:,.0f}\".format(doc.actual_amt_after_tds_inr or 0) }}</div>\r\n        <div class=\"s-note\">(approx) @ {{ doc.exchange_rate or 0 }}</div>\r\n      </td>\r\n    </tr>\r\n\r\n    <!-- 14: Date of deduction -->\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">14</td>\r\n      <td class=\"c-label vmid\">Date of deduction of tax at source, if any</td>\r\n      <td colspan=\"2\" class=\"center vmid bold\">\r\n        {% if doc.trc_obtained and doc.date_of_deduction_of_tax_at_source %}{{ frappe.utils.formatdate(doc.date_of_deduction_of_tax_at_source, \"dd-MM-yyyy\") }}{% endif %}\r\n      </td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">15</td>\r\n      <td class=\"c-label vmid\">Before VAT Amount</td>\r\n      <td colspan=\"2\" class=\"center vmid\">\r\n          {{ \"{:,.0f}\".format(doc.before_vat_amount or 0)}}\r\n      </td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col\"></td>\r\n      <td class=\"c-idx vmid\">16</td>\r\n      <td class=\"c-label vmid\">VAT</td>\r\n      <td colspan=\"2\" class=\"center vmid\">\r\n          {{ \"{:,.0f}\".format(doc.vat or 0) }}\r\n      </td>\r\n    </tr>\r\n    <tr>\r\n      <td class=\"c-idx vmid b-col-last\"></td>\r\n      <td class=\"c-idx vmid\">17</td>\r\n      <td class=\"c-label vmid\">Total Amount (With VAT)</td>\r\n      <td colspan=\"2\" class=\"center vmid\">\r\n          {{ \"{:,.0f}\".format(doc.total_amount or 0) }}\r\n      </td>\r\n    </tr>\r\n  </table>\r\n\r\n  <div class=\"f-footer\">\r\n    * Applicable to remittance of amount exceeding five lakh rupees in the aggregate in a financial year\r\n    where such remittance is chargeable to tax under the Income-tax Act, 2025.\r\n  </div>\r\n\r\n</div><!-- .f15cb -->\r\n",
